<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>QtWidgetsApplication1Class</class>
 <widget class="QMainWindow" name="QtWidgetsApplication1Class">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1600</width><height>900</height></rect></property>
  <property name="minimumSize"><size><width>1280</width><height>720</height></size></property>
  <property name="windowTitle"><string>虎牌·暖光酒馆牌桌 UI 专项优化版</string></property>
  <property name="styleSheet"><string notr="true">QMainWindow{background:#080503;}
QWidget#centralWidget{color:#f1dbad;font-family:"Microsoft YaHei UI";border-image:url(:/ui/tavern_table_background.svg) 0 0 0 0 stretch stretch;}
QLabel{background:transparent;color:#f1dbad;}
QFrame#topBarFrame{background:rgba(5,3,2,205);border:none;border-bottom:1px solid rgba(156,106,47,145);}
QLabel#roomLabel{color:#b89052;font-size:13px;}
QLabel#titleLabel{color:#e8bd6a;font-family:"STKaiti","KaiTi","Microsoft YaHei UI";font-size:31px;font-weight:800;}
QLabel#eventStatusLabel{background:rgba(24,14,7,220);border:1px solid #7f5b2c;border-radius:6px;color:#d8b36e;padding:2px 12px;font-size:12px;}
QPushButton#rulesButton{background:rgba(30,18,9,220);border:1px solid #8c642f;border-radius:18px;color:#d9b773;font-size:17px;padding:4px;}
QFrame#tableSurfaceFrame{background:qradialgradient(cx:0.48,cy:0.47,radius:0.74,fx:0.48,fy:0.43,stop:0 rgba(131,75,31,230),stop:0.54 rgba(78,41,17,234),stop:0.83 rgba(42,21,9,242),stop:1 rgba(12,7,4,248));border:4px solid #7f5124;border-radius:255px;}
QFrame#humanPanel,QFrame#opponentSeat1,QFrame#opponentSeat2,QFrame#opponentSeat3{background:rgba(10,7,4,218);border:1px solid rgba(118,83,40,170);border-radius:13px;}
QLabel#humanAvatarLabel,QLabel#opponentAvatar1,QLabel#opponentAvatar2,QLabel#opponentAvatar3{background:qradialgradient(cx:.5,cy:.45,radius:.65,stop:0 #6e431c,stop:1 #201208);border:3px solid #7f592b;border-radius:34px;color:#ffe1a0;font-size:33px;}
QLabel#playerInfoLabel,QLabel#opponentLabel1,QLabel#opponentLabel2,QLabel#opponentLabel3{color:#f2dab0;font-size:15px;font-weight:bold;}
QLabel#humanCardsLabel,QLabel#opponentCards1,QLabel#opponentCards2,QLabel#opponentCards3{color:#9eb0b7;font-size:25px;letter-spacing:-6px;}
QLabel#humanCountLabel,QLabel#opponentCount1,QLabel#opponentCount2,QLabel#opponentCount3{color:#f5cf82;font-family:"Georgia";font-size:27px;font-weight:bold;}
QLabel#humanRankBadge,QLabel#opponentRankBadge1,QLabel#opponentRankBadge2,QLabel#opponentRankBadge3{background:#261506;border:2px solid #e0ad4f;border-radius:15px;color:#ffe19a;font-size:17px;font-weight:bold;}
QFrame#centerPlayFrame{background:rgba(14,8,4,92);border:none;border-radius:26px;}
QFrame#lastPlayFrame{background:rgba(18,10,5,165);border:1px solid rgba(167,112,46,130);border-radius:12px;}
QLabel#lastPlayPlayerLabel{color:#c9a568;font-size:15px;}
QLabel#claimLabel{color:#ffe1a0;font-family:"Georgia","Microsoft YaHei UI";font-size:31px;font-weight:bold;}
QFrame#cardStageFrame{background:transparent;border:none;}
QLabel#tableCard1,QLabel#tableCard2,QLabel#tableCard3{background:qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #263d55,stop:.5 #10263b,stop:1 #07131f);border:4px double #b78b48;border-radius:9px;color:#e5c47e;font-family:"STKaiti","KaiTi";font-size:20px;font-weight:bold;}
QLabel#tableCardStatusLabel{color:#ae8e57;font-size:12px;}
QFrame#pileFrame{background:rgba(11,7,4,150);border:none;border-radius:10px;}
QLabel#pileStackLabel{color:#9cadb3;font-size:32px;letter-spacing:-12px;}
QLabel#pileCountLabel{color:#f4cc7a;font-family:"Georgia","Microsoft YaHei UI";font-size:22px;font-weight:bold;}
QFrame#decisionActionPanel{background:rgba(10,6,3,180);border:1px solid rgba(143,99,45,155);border-radius:9px;}
QLabel#phaseLabel{color:#f1d49a;font-size:15px;font-weight:bold;}
QLabel#actionLabel{color:#bfa16b;font-size:13px;}
QFrame#eventBannerFrame{background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 rgba(37,18,7,220),stop:.5 rgba(83,45,16,245),stop:1 rgba(37,18,7,220));border:2px solid #b47a30;border-radius:8px;}
QLabel#eventLabel{color:#ffe09a;font-size:17px;font-weight:bold;}
QFrame#actionFrame{background:rgba(12,7,4,205);border:1px solid rgba(134,91,39,160);border-radius:11px;}
QPushButton{color:#fbe6bc;border-radius:8px;padding:7px 18px;font-weight:bold;}
QPushButton:hover{border-color:#ffe19a;}
QPushButton:pressed{padding-top:9px;padding-bottom:5px;}
QPushButton:disabled{background:rgba(43,38,32,215);color:#6d665c;border:1px solid #51493e;}
QPushButton#playButton{background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #8f3320,stop:1 #45150d);border:2px solid #c47645;font-size:20px;}
QPushButton#believeButton{background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #315f43,stop:1 #173423);border:2px solid #719b67;font-size:20px;}
QPushButton#challengeButton{background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #755019,stop:1 #3c270a);border:2px solid #c19036;font-size:20px;}
QComboBox{background:rgba(19,12,7,245);color:#f7d58e;border:1px solid #95682d;border-radius:7px;padding:7px 24px 7px 10px;min-width:72px;font-size:16px;}
QProgressBar{background:#140d07;border:1px solid #9f7235;border-radius:5px;color:#f2d596;text-align:center;font-size:11px;}
QProgressBar::chunk{background:#a66d24;border-radius:4px;}
QFrame#handPanel{background:rgba(7,5,3,218);border:none;border-top:1px solid rgba(131,90,41,150);}
QScrollArea#handScrollArea,QWidget#handContainer{background:transparent;border:none;}
QFrame#privateInfoFrame{background:rgba(17,10,5,232);border:1px solid #765225;border-radius:9px;}
QLabel#privateInfoTitle{color:#e6bd72;font-size:15px;font-weight:bold;}
QLabel#taskLabel,QLabel#rewardLabel{color:#d9c49a;font-size:12px;}
QPushButton#rewardButton,QPushButton#restartButton{background:rgba(72,39,14,235);border:1px solid #a87531;font-size:13px;}</string></property>
